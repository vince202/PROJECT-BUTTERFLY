{
  "name": "butterfly",
  "private": true,
  "version": "0.1.0",
  "description": "BUTTERFLY — Twenty Lives. One Day. Infinite Possibilities. Autonomous living city & causal simulation engine.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "cli": "tsx scripts/cli.ts",
    "cli:advised": "tsx --env-file-if-exists=.env scripts/llm-day.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
