# Optional LLM adapter (server/index.ts). Never commit a real key.
# Leave empty to run BUTTERFLY with deterministic local fallbacks (AI narration disabled).
ANTHROPIC_API_KEY=
# Narration/interpretation model. Haiku is fast and cheap; set claude-sonnet-5-5 or claude-opus-5-5 for richer prose at a higher cost.
ANTHROPIC_MODEL=claude-haiku-5-5
BUTTERFLY_AI_PORT=8787

# Optional decision advisor: Jev (TypeSafe System One, typed decisions, input-only billing).
# When set, Jev arbitrates the inhabitants' open choices; otherwise the Anthropic key is used, else a deterministic mock.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Force the advisor: jev | anthropic | none
BUTTERFLY_ADVISOR=

# Optional local embeddings for memory recall (Ollama on your machine, free). Example: `ollama pull embeddinggemma`.
# Without Ollama, BUTTERFLY uses a deterministic lexical fallback. Set BUTTERFLY_EMBED=off to disable the probe.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma
BUTTERFLY_EMBED=
